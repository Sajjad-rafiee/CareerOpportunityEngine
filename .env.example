POSTGRES_DB=career_opportunity_engine
POSTGRES_USER=coe
POSTGRES_PASSWORD=
# 5433, not the default 5432, in case another Postgres is already running on your machine
POSTGRES_PORT=5433

# Free key from https://aistudio.google.com/apikey - only needed for
# scripts/load_greenhouse_to_db.py's eligibility extraction step
GEMINI_API_KEY=

# Distributed tracing (OpenTelemetry), off by default. Set
# OTEL_TRACES_EXPORTER=otlp to send spans to a local Jaeger instance. Run
# directly on the host, http://localhost:4318 works; running the `app`
# container via docker-compose.yml, use http://host.docker.internal:4318
# instead (that container's OTEL_EXPORTER_OTLP_ENDPOINT default already does).
OTEL_SERVICE_NAME=career-opportunity-engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=none
OTEL_PROPAGATORS=tracecontext,baggage

# Local-only fault injection for the observability demo: "none" (default),
# "delay" (~2s before searching), or "error" (503 instead of searching).
OTEL_DEMO_FAULT_MODE=none